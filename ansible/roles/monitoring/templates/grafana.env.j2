# Managed by Ansible. Contains a secret: root-only, do not copy.
# GF_SECURITY_ADMIN_PASSWORD is only used when Grafana first creates its database;
# after that the password lives in Grafana (rotate with `grafana cli admin reset-admin-password`).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD={{ monitoring_grafana_password }}
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
# Grafana's default preinstalled apps are off. The one plugin we need (VictoriaLogs
# datasource) is installed by the role, pinned, with `grafana cli`.
GF_PLUGINS_PREINSTALL_DISABLED=true
GF_LOG_LEVEL=warn
GF_SERVER_ROOT_URL=https://{{ fqdns['grafana.lab'] }}/
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana-dashboards/host.json
