# Managed by Ansible. Contains a secret: root-only, do not copy.
API_KEY={{ app_api_key }}
DATABASE_URL={{ app_database_url }}
BASE_URL=https://{{ primary_fqdn }}
BIND_ADDR=0.0.0.0:8080
LOG_FORMAT={{ app_log_format }}
RUST_LOG={{ app_log_level }}
{% if app_otel_endpoint %}
OTEL_EXPORTER_OTLP_ENDPOINT={{ app_otel_endpoint }}
OTEL_TRACES_SAMPLER_ARG={{ app_otel_sample_ratio }}
{% endif %}
