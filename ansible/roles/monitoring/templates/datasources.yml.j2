# Managed by Ansible. Do not edit on the host.
apiVersion: 1
datasources:
  - name: VictoriaMetrics
    uid: victoriametrics
    type: prometheus
    access: proxy
    url: http://victoriametrics:8428
    isDefault: true
    editable: false
    jsonData:
      httpMethod: POST
      timeInterval: {{ monitoring_scrape_interval }}
  - name: VictoriaLogs
    uid: victorialogs
    type: victoriametrics-logs-datasource
    access: proxy
    url: http://victorialogs:9428
    editable: false
  # Traces: VictoriaTraces speaks the Jaeger query API, which Grafana supports natively.
  - name: VictoriaTraces
    uid: victoriatraces
    type: jaeger
    access: proxy
    url: http://victoriatraces:10428/select/jaeger
    editable: false
  # Reads CPU credit metrics, which only CloudWatch can see. Credentials come from the
  # instance role through the metadata service (see the compute module's cloudwatch-read policy).
  - name: CloudWatch
    uid: cloudwatch
    type: cloudwatch
    editable: false
    jsonData:
      authType: default
      defaultRegion: {{ ansible_aws_ssm_region }}
