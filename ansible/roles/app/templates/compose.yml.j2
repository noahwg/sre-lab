# Managed by Ansible. Do not edit on the host.
name: shortener

services:
  shortener:
    image: {{ app_image }}
    container_name: shortener
    # Adds the compose service name to each log line (Fluent Bit uses it as the source).
    logging:
      driver: json-file
      options:
        max-size: "{{ docker_log_max_size | default('10m') }}"
        max-file: "{{ docker_log_max_file | default('3') }}"
        labels: "com.docker.compose.service"
    restart: unless-stopped
    env_file:
      - {{ app_dir }}/app.env
    networks:
      - {{ app_network }}
      - {{ app_db_network }}
    mem_limit: {{ app_memory_limit }}
    # The image is distroless and the app only needs to listen on a port.
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "/app/shortener", "healthcheck"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 5s

networks:
  {{ app_network }}:
    name: {{ app_network }}
    external: true
  {{ app_db_network }}:
    name: {{ app_db_network }}
    external: true
