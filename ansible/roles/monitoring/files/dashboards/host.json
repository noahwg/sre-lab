{
  "uid": "sre-lab-host",
  "title": "Host",
  "tags": [
    "sre-lab",
    "infrastructure"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
